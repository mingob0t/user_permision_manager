# Frontend Next.js de @APP_TITLE@.
# Requiere `npm ci && npm run build` previo: el build standalone deja el
# servidor en .next/standalone/server.js
[Unit]
Description=@APP_TITLE@ Frontend (Next.js)
After=network.target @APP_NAME@-backend.service
Wants=@APP_NAME@-backend.service

[Service]
Type=simple
User=@SVC_USER@
Group=@SVC_GROUP@
# server.js resuelve .next/static y public/ relativos a su propio directorio,
# así que el WorkingDirectory debe ser standalone, no frontend/.
WorkingDirectory=@PREFIX@/frontend/.next/standalone
Environment=NODE_ENV=production
Environment=PORT=@WEB_PORT@
Environment=HOSTNAME=127.0.0.1
# SSR: Next habla con Flask por loopback, en el mismo puerto que nginx (FNC-127).
Environment=BACKEND_URL=http://localhost:@API_PORT@
# Con `output: standalone` hay que arrancar este server.js, no `next start`.
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
