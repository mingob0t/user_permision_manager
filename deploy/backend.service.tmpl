# API Flask de @APP_TITLE@.
# Instalar en /etc/systemd/system/ y ajustar User, WorkingDirectory y rutas.
# El marcador DB_SERVICE es el servicio de la BD local (mysqld, mariadb o mysql) que detecta
# install.sh; sin BD local, install.sh quita la dependencia (FNC-125).
[Unit]
Description=@APP_TITLE@ API (Flask/Gunicorn)
After=network.target @DB_SERVICE@
Wants=@DB_SERVICE@

[Service]
Type=simple
User=@SVC_USER@
Group=@SVC_GROUP@
WorkingDirectory=@PREFIX@
EnvironmentFile=@PREFIX@/.env
ExecStart=@PREFIX@/venv/bin/gunicorn \
    --workers 4 \
    --bind 127.0.0.1:@API_PORT@ \
    --timeout 120 \
    --access-logfile @LOGDIR@/access.log \
    --error-logfile @LOGDIR@/error.log \
    "run:app"
Restart=on-failure
RestartSec=5

# Endurecimiento: el backend no escribe en disco —los datos van a la base de
# datos y el logo del portal se guarda como data URI—, así que solo necesita
# poder escribir sus registros.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@LOGDIR@

[Install]
WantedBy=multi-user.target
