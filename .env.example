# === NEXUS MI_NUEVO_PROYECTO CONFIGURATION ===
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=cambiar-por-una-cadena-larga-y-aleatoria

# DATABASE
DB_ENGINE=mysql
DB_HOST=localhost
DB_USER=nexus
DB_PASS=
DB_NAME=admin_test
DB_PORT=3306

# REDIS (cola de aprovisionamiento, ADR-003). Solo nombre de host, nunca IP.
REDIS_HOST=localhost
REDIS_PORT=6379
# Secreto, obligatorio para el worker (FNC-049): .env en dev; Vaultwarden
# pokemon/<entorno>/REDIS_PASS. Sin ella la API arranca y los trabajos esperan.
REDIS_PASS=

# EJECUTOR DE APROVISIONAMIENTO (FNC-049). Vacío = valor por defecto.
# Worker: flask provisioning worker
PROVISIONING_QUEUE_NAME=aprovisionamiento
PROVISIONING_MAX_ATTEMPTS=5
PROVISIONING_BACKOFF_BASE_SECONDS=60
PROVISIONING_BACKOFF_MAX_SECONDS=900
PROVISIONING_ATTEMPT_TIMEOUT_SECONDS=60
PROVISIONING_POLL_INTERVAL_SECONDS=30

# CONECTORES (FNC-050, ADR-005). Solo nombres de host, nunca IP.
# Lista blanca de destinos separada por coma; vacía = ningún conector se ejecuta.
CONNECTOR_ALLOWED_HOSTS=
# Tiempo de espera por llamada (menor que PROVISIONING_ATTEMPT_TIMEOUT_SECONDS).
CONNECTOR_TIMEOUT_SECONDS=10
# Caché en memoria de las credenciales resueltas; 0 = sin caché.
CONNECTOR_CREDENTIAL_CACHE_SECONDS=60
# Conector API HTTP (FNC-051): archivo con la CA que firma el certificado de las
# plataformas (ruta, no secreto); vacío = CA del sistema. TLS siempre validado.
CONNECTOR_HTTP_CA_FILE=
# Secreto, solo dev (APP_ENV=development): credencial de cada conector según su
# credential_ref en mayúsculas y con _ (pokemon/contabilidad-api ->
# CONNECTOR_CREDENTIAL_POKEMON_CONTABILIDAD_API; usuario opcional en
# ..._USUARIO con doble guion bajo). Fuera de dev viene de Vaultwarden (FNC-068).
# La variable no puede tener __ ni dos referencias distintas dar la misma.
# CONNECTOR_CREDENTIAL_POKEMON_CONTABILIDAD_API=
# CONNECTOR_CREDENTIAL_POKEMON_CONTABILIDAD_API__USUARIO=

# SYSTEM
PORT_APP=5001
TZ_APP=America/Mexico_City

# SSO AUTHELIA
AUTHELIA_ENABLED=false
AUTHELIA_SSO_URL=https://auth.vivaro.com:9091
AUTHELIA_SLO_URL=https://auth.vivaro.com:9091/logout
AUTHELIA_HEADER_USER=Remote-Email
AUTHELIA_HEADER_NAME=Remote-Name
BASE_URL=http://localhost:5001
DEBUG_AUTH=true

# LOGIN LOCAL (FNC-077)
# El login local solo admite la cuenta de emergencia (superadmin local).
# Entorno de la app: development | staging | production. Vacío = no es
# desarrollo (lo más seguro).
APP_ENV=
# Solo desarrollo, para la prueba de concepto sin Authelia: true permite el
# login local de cualquier cuenta local y fijar su contraseña. Se ignora si
# APP_ENV no es development.
LOGIN_LOCAL_TODAS_LAS_CUENTAS=false
NGINX_CONF_PATH=/etc/nginx/conf.d/vivaro.conf

# SMTP (correo saliente)
# Por defecto manda la configuración guardada desde la interfaz y estos valores
# solo actúan de respaldo si en la base de datos no hay nada.
# Con SMTP_FORCE_ENV=true se usan siempre estos y la interfaz pasa a solo
# lectura: sirve para fijar el servidor por despliegue.
SMTP_FORCE_ENV=false
SMTP_SERVER=
SMTP_PORT=587
SMTP_ENCRYPTION=starttls
SMTP_AUTH=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_NAME=Nexus
SMTP_SENDER_EMAIL=

# Interruptor global: en false no se envía ningún correo.
ENABLE_NOTIFICATIONS=true
# Correos del gestor de accesos (solicitudes, decisiones y fallos de
# aprovisionamiento). En false no se envían; ENABLE_NOTIFICATIONS manda.
NOTIFY_ACCESS_EVENTS=true
DEBUG_SMTP=false

# FRONTEND
# Dónde redirigir las rutas heredadas. Tras Nginx puede quedar vacío (mismo
# dominio); en desarrollo, el puerto de Next.js.
FRONTEND_URL=http://localhost:3000
# Next.js (frontend/): backend para el rewrite de dev y el SSR; por defecto
# http://localhost:5001 (FNC-069).
BACKEND_URL=http://localhost:5001
# Solo desarrollo: 1 = el cliente del gestor de accesos usa los datos
# simulados de docs/contratos/ (sin efecto en un build de producción).
# Next.js no lee este archivo: BACKEND_URL y NEXT_PUBLIC_ACCESS_MOCKS van en
# frontend/.env.local o al lanzar (NEXT_PUBLIC_ACCESS_MOCKS=1 npm run dev).
NEXT_PUBLIC_ACCESS_MOCKS=

# Solo estas direcciones pueden inyectar las cabeceras Remote-* del SSO y,
# para la auditoría, X-Forwarded-For (IP real del cliente, FNC-047).
TRUSTED_PROXIES=127.0.0.1,::1

# DIRECTORIO OpenLDAP (FNC-040, ADR-004)
# Vacío = directorio inactivo. Con LDAP_URL definida, la app no arranca si
# falta algo o si no hay TLS: ldaps://<host> o ldap://<host> (con StartTLS).
# Solo nombres de host, nunca IP. Los valores los define el dueño.
LDAP_URL=
# CA para validar el certificado del servidor; vacío = CA del sistema.
LDAP_CA_CERT_FILE=
LDAP_BIND_DN=
# Secreto: .env en dev; Vaultwarden pokemon/<entorno>/LDAP_BIND_PASSWORD.
LDAP_BIND_PASSWORD=
LDAP_USERS_BASE_DN=
LDAP_GROUPS_BASE_DN=
# Esquema (por defecto, el estándar de OpenLDAP): uid, groupOfNames, member.
LDAP_USER_ATTR=uid
LDAP_GROUP_OBJECT_CLASS=groupOfNames
LDAP_GROUP_MEMBER_ATTR=member
LDAP_TIMEOUT_SECONDS=5
# Escritura (FNC-041). Clases de las cuentas que crea el portal, separadas
# por coma; vacío = inetOrgPerson.
LDAP_USER_OBJECT_CLASSES=
# DN que ocupa un groupOfNames al quitar a su último miembro; vacío = no se
# quita el último miembro (la baja falla como error permanente).
LDAP_GROUP_PLACEHOLDER_MEMBER=
# Convención del DN de grupo de cada plataforma (FNC-046), relativa a
# LDAP_GROUPS_BASE_DN. Marcadores: {plataforma} y {nivel} obligatorios, {area}
# opcional. Ejemplo: cn={plataforma}-{nivel},ou={area}
# Vacío = no se deriva: el superadmin indica los grupos de cada plataforma.
LDAP_PLATFORM_GROUP_TEMPLATE=
