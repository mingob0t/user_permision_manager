# === NEXUS MI_NUEVO_PROYECTO CONFIGURATION ===
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=cambiar-por-una-cadena-larga-y-aleatoria

# DATABASE
DB_ENGINE=mysql
DB_HOST=localhost
DB_USER=nexus
DB_PASS=
DB_NAME=admin_test
DB_PORT=3306

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379

# SYSTEM
PORT_APP=5001
TZ_APP=America/Mexico_City

# SSO AUTHELIA
AUTHELIA_ENABLED=false
AUTHELIA_SSO_URL=https://auth.vivaro.com:9091
AUTHELIA_SLO_URL=https://auth.vivaro.com:9091/logout
AUTHELIA_HEADER_USER=Remote-Email
AUTHELIA_HEADER_NAME=Remote-Name
AUTHELIA_HEADER_GROUPS=Remote-Groups
AUTHELIA_GROUP_ADMIN=InfraestructuraVOIP,Soporte de Red
BASE_URL=http://localhost:5001
DEBUG_AUTH=true
NGINX_CONF_PATH=/etc/nginx/conf.d/vivaro.conf

# SMTP (correo saliente)
# Por defecto manda la configuración guardada desde la interfaz y estos valores
# solo actúan de respaldo si en la base de datos no hay nada.
# Con SMTP_FORCE_ENV=true se usan siempre estos y la interfaz pasa a solo
# lectura: sirve para fijar el servidor por despliegue.
SMTP_FORCE_ENV=false
SMTP_SERVER=
SMTP_PORT=587
SMTP_ENCRYPTION=starttls
SMTP_AUTH=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_NAME=Nexus
SMTP_SENDER_EMAIL=

# Interruptor global: en false no se envía ningún correo.
ENABLE_NOTIFICATIONS=true
# Correos del gestor de accesos (solicitudes, decisiones y fallos de
# aprovisionamiento). En false no se envían; ENABLE_NOTIFICATIONS manda.
NOTIFY_ACCESS_EVENTS=true
DEBUG_SMTP=false

# FRONTEND
# Dónde redirigir las rutas heredadas. Tras Nginx puede quedar vacío (mismo
# dominio); en desarrollo, el puerto de Next.js.
FRONTEND_URL=http://localhost:3000

# Solo estas direcciones pueden inyectar las cabeceras Remote-* del SSO y,
# para la auditoría, X-Forwarded-For (IP real del cliente, FNC-047).
TRUSTED_PROXIES=127.0.0.1,::1

# DIRECTORIO OpenLDAP (FNC-040, ADR-004)
# Vacío = directorio inactivo. Con LDAP_URL definida, la app no arranca si
# falta algo o si no hay TLS: ldaps://<host> o ldap://<host> (con StartTLS).
# Solo nombres de host, nunca IP. Los valores los define el dueño.
LDAP_URL=
# CA para validar el certificado del servidor; vacío = CA del sistema.
LDAP_CA_CERT_FILE=
LDAP_BIND_DN=
# Secreto: .env en dev; Vaultwarden pokemon/<entorno>/LDAP_BIND_PASSWORD.
LDAP_BIND_PASSWORD=
LDAP_USERS_BASE_DN=
LDAP_GROUPS_BASE_DN=
# Esquema (por defecto, el estándar de OpenLDAP): uid, groupOfNames, member.
LDAP_USER_ATTR=uid
LDAP_GROUP_OBJECT_CLASS=groupOfNames
LDAP_GROUP_MEMBER_ATTR=member
LDAP_TIMEOUT_SECONDS=5
# Escritura (FNC-041). Clases de las cuentas que crea el portal, separadas
# por coma; vacío = inetOrgPerson.
LDAP_USER_OBJECT_CLASSES=
# DN que ocupa un groupOfNames al quitar a su último miembro; vacío = no se
# quita el último miembro (la baja falla como error permanente).
LDAP_GROUP_PLACEHOLDER_MEMBER=
