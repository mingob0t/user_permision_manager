# === ADUANA CONFIGURATION ===
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=cambiar-por-una-cadena-larga-y-aleatoria

# DATABASE
# DB_ENGINE: mysql (MySQL o MariaDB) o postgresql (FNC-146). Fuera de
# desarrollo (APP_ENV distinto de development) es obligatorio uno de los dos:
# sin él la app no arranca (FNC-134). SQLite solo con APP_ENV=development.
# DB_PORT: 3306 para mysql, 5432 para postgresql; vacío = el del motor.
DB_ENGINE=mysql
DB_HOST=localhost
DB_USER=nexus
DB_PASS=
DB_NAME=admin_test
DB_PORT=3306
# TLS hacia una BD remota (FNC-151): ruta del certificado de la CA. Vacío = sin TLS.
DB_TLS_CA_FILE=

# LÍMITE DE INTENTOS DE LOGIN (FNC-014). Vacío = valor por defecto.
# LOGIN_MAX_INTENTOS_CUENTA=10
# LOGIN_MAX_INTENTOS_IP=30
# LOGIN_VENTANA_MINUTOS=15

# REDIS (cola de aprovisionamiento, ADR-003). Solo nombre de host, nunca IP.
REDIS_HOST=localhost
REDIS_PORT=6379
# Secreto, obligatorio para el worker (FNC-049): .env en dev; Vaultwarden
# pokemon/<entorno>/REDIS_PASS. Sin ella la API arranca y los trabajos esperan.
REDIS_PASS=

# EJECUTOR DE APROVISIONAMIENTO (FNC-049). Vacío = valor por defecto.
# Worker: flask provisioning worker
PROVISIONING_QUEUE_NAME=aprovisionamiento
PROVISIONING_MAX_ATTEMPTS=5
PROVISIONING_BACKOFF_BASE_SECONDS=60
PROVISIONING_BACKOFF_MAX_SECONDS=900
PROVISIONING_ATTEMPT_TIMEOUT_SECONDS=60
PROVISIONING_POLL_INTERVAL_SECONDS=30

# CONECTORES (FNC-050, ADR-005). Solo nombres de host, nunca IP.
# Lista blanca de destinos separada por coma; vacía = ningún conector se ejecuta.
CONNECTOR_ALLOWED_HOSTS=
# Tiempo de espera por llamada (menor que PROVISIONING_ATTEMPT_TIMEOUT_SECONDS).
CONNECTOR_TIMEOUT_SECONDS=10
# Caché en memoria de las credenciales resueltas; 0 = sin caché.
CONNECTOR_CREDENTIAL_CACHE_SECONDS=60
# Conector API HTTP (FNC-051): archivo con la CA que firma el certificado de las
# plataformas (ruta, no secreto); vacío = CA del sistema. TLS siempre validado.
CONNECTOR_HTTP_CA_FILE=
# Conector base de datos (FNC-053): tiempo máximo de conexión y de cada consulta (el
# doble debe ser menor que PROVISIONING_ATTEMPT_TIMEOUT_SECONDS) y archivo con la CA
# de las bases de datos (ruta, no secreto); vacío = CA del sistema. TLS siempre validado.
CONNECTOR_DB_TIMEOUT_SECONDS=10
CONNECTOR_DB_CA_FILE=

# VAULTWARDEN (FNC-068, ADR-005 A, FNC-136, ADR-008). Solo staging y producción:
# en dev se ignora. Cuenta de servicio para Secrets y Sends.
# Habilitar/deshabilitar explícitamente la integración (true/false).
# Si está en false o vacío (sin variables), Vaultwarden queda desactivado.
# Si solo se usa para Sends (onboarding o reset admin), no se requiere VAULTWARDEN_COLLECTION_ID.
VAULTWARDEN_ENABLED=false
# https://<host>[/ruta]; nombre de host, nunca IP.
VAULTWARDEN_URL=
# CA propia en PEM (vacía = CA del sistema).
VAULTWARDEN_CA_CERT_FILE=
# Llave de API PERSONAL de la cuenta de servicio (user.<uuid>).
VAULTWARDEN_CLIENT_ID=
# Secreto: lo pone una persona en el .env del servidor; nunca en el repo.
VAULTWARDEN_CLIENT_SECRET=
VAULTWARDEN_EMAIL=
# Secreto: descifra la bóveda del lado del cliente.
VAULTWARDEN_MASTER_PASSWORD=
# Id (uuid) de la colección del portal (opcional si solo se usan Sends).
VAULTWARDEN_COLLECTION_ID=
# Espera de cada operación de red, 1-30 s. Vacía = 5 s. Se deja vacía para que
# un .env sin Vaultwarden no lo active por accidente (preflight lo toma como «en uso»).
VAULTWARDEN_TIMEOUT_SECONDS=
# Sends de onboarding (FNC-136, ADR-008): el portal entrega la contraseña
# inicial por un Send. Modo: api (por defecto; API con la cuenta de servicio)
# o bw (CLI bw del servidor con sesión desbloqueada). Vacías = valores por defecto.
VAULTWARDEN_SEND_MODO=
# Solo modo bw: ejecutable (mejor ruta absoluta) y sesión desbloqueada (secreto).
VAULTWARDEN_BW_BIN=
VAULTWARDEN_BW_SESSION=
# Base del enlace del Send (vacía = VAULTWARDEN_URL); https://<host>, nunca IP.
VAULTWARDEN_SEND_BASE_URL=
# true = el Send oculta el correo de la cuenta que lo crea (Vaultwarden muestra
# entonces «el usuario ocultó su correo; confía en la fuente»). Vacío/false = visible.
VAULTWARDEN_SEND_OCULTAR_CORREO=
# Caducidad (1-30 días), aperturas máximas (1-10) y borrado automático
# (>= caducidad, <= 31 días). Por defecto 7, 3 y 7.
ONBOARDING_SEND_EXPIRATION_DAYS=
ONBOARDING_SEND_MAX_ACCESS_COUNT=
ONBOARDING_SEND_DELETION_DAYS=
# Política de la contraseña inicial de onboarding (FNC-138). Vacías = por
# defecto: largo 16-128, clases mayusculas,minusculas,digitos,simbolos y
# símbolos ASCII sin comillas ni barra invertida. Se validan al arrancar.
PASSWORD_POLICY_MIN_LENGTH=16
PASSWORD_POLICY_MAX_LENGTH=128
PASSWORD_POLICY_GENERATED_LENGTH=16
PASSWORD_POLICY_REQUIRED_CLASSES=
PASSWORD_POLICY_SYMBOLS=

# SYSTEM
# Solo desarrollo (`python run.py`); run.py fija 5001 y no la lee. En
# staging/prod el puerto del backend es API_PORT.
PORT_APP=5001
# Puertos de loopback del despliegue (deploy/install.sh y preflight.sh, FNC-127).
# Solo se leen estas dos líneas; la opción --web-port/--api-port y la variable
# de entorno tienen prioridad. Enteros 1024-65535, distintos.
# WEB_PORT=3000
# API_PORT=5001
TZ_APP=America/Mexico_City
# Respaldo de TZ_APP (estándar del sistema). Con un valor, no vacío: si TZ_APP
# falta y TZ queda vacía, el proceso toma UTC.
TZ=America/Mexico_City

# INICIO DE SESIÓN POR AUTHELIA (OIDC, FNC-141, ADR-009)
# Todo el acceso de las personas pasa por Authelia (4.38 o mayor). Fuera de
# desarrollo las cuatro primeras son obligatorias, con https y nombre de host
# (nunca IP); sin ellas la app no arranca. En desarrollo, con todas vacías, se
# entra por /acceso-emergencia; con alguna con valor se exigen todas.
# Guía y bloque del cliente en docs/operacion/AUTHELIA-OIDC.md.
# OIDC_HABILITADO=false: instala y arranca SIN Authelia (aún no configurado);
# en /login entran solo las cuentas locales (FNC-157, FNC-158).
# Vacío o true = Authelia obligatorio fuera de desarrollo.
OIDC_HABILITADO=
# Ejemplo: https://auth.ejemplo.local
OIDC_ISSUER_URL=
# Vacío = portal
OIDC_CLIENT_ID=
# Secreto del cliente: solo en el .env del entorno (600). Nunca en el repo, logs ni respuestas.
OIDC_CLIENT_SECRET=
# Ejemplo: https://portal.ejemplo.local/api/v1/auth/oidc/callback
OIDC_REDIRECT_URI=
# Vacío = openid profile email groups.
OIDC_SCOPES=
# Mapeo de grupos OIDC de Authelia a roles del portal (FNC-143):
# Grupo para rol Superadmin (administrador; por omisión: infraestructuraVoIP)
OIDC_GROUP_SUPERADMIN=infraestructuraVoIP
# Grupo para rol Administrador de Área (admin_area; por omisión: app-aduana-admins)
OIDC_GROUP_AREA_ADMIN=app-aduana-admins
# Grupo para rol Usuario regular (usuario; por omisión: app-aduana-users)
OIDC_GROUP_USER=app-aduana-users
# Cierre de sesión de Authelia (opcional; ejemplo https://auth.ejemplo.local/logout).
# Vacío = el end_session_endpoint del descubrimiento, si existe.
# Obligatoria fuera de desarrollo: sin ella, cerrar sesión no cierra Authelia.
OIDC_LOGOUT_URL=
BASE_URL=http://localhost:5001

# IDENTIDAD Y MARCA DE LA PLATAFORMA
# Permite personalizar el nombre visible, identificador técnico y dominio sin atarse a una marca fija
APP_NAME=aduana
APP_TITLE=Aduana
NEXT_PUBLIC_APP_TITLE=Aduana
DOMAIN=aduana.example.com
NEXT_PUBLIC_DOMAIN=aduana.example.com

# SOPORTE Y CONTACTO
# Correo para solicitudes de acceso y atención de usuarios sin permisos
SUPPORT_EMAIL=aduana-app@vivaro.com
NEXT_PUBLIC_SUPPORT_EMAIL=aduana-app@vivaro.com

# ENTORNO DE LA APLICACIÓN (APP_ENV)
# development: desarrollo local (permite SQLite y HTTP).
# staging / production: servidores seguros (exige PostgreSQL/MySQL y HTTPS).
APP_ENV=production
# Solo desarrollo: true permite login local de pruebas sin Authelia.
LOGIN_LOCAL_TODAS_LAS_CUENTAS=false

# SMTP (correo saliente)
# Por defecto manda la configuración guardada desde la interfaz y estos valores
# solo actúan de respaldo si en la base de datos no hay nada.
# Con SMTP_FORCE_ENV=true se usan siempre estos y la interfaz pasa a solo
# lectura: sirve para fijar el servidor por despliegue.
SMTP_FORCE_ENV=false
SMTP_SERVER=
SMTP_PORT=587
SMTP_ENCRYPTION=starttls
SMTP_AUTH=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_NAME=Portal
SMTP_SENDER_EMAIL=

# Interruptor global: en false no se envía ningún correo.
ENABLE_NOTIFICATIONS=true
# Correos del gestor de accesos (solicitudes, decisiones y fallos de
# aprovisionamiento). En false no se envían; ENABLE_NOTIFICATIONS manda.
NOTIFY_ACCESS_EVENTS=true
# Aviso a quienes tienen acceso cuando se desactiva una plataforma o un área
# (no se avisa al reactivar). ENABLE_NOTIFICATIONS manda.
NOTIFY_PLATFORM_DEACTIVATION=true
DEBUG_SMTP=false
# Log legible de eventos (quién solicitó, aprobó, dio de alta/baja, desactivó,
# correos enviados): una línea por evento en logs/eventos.log y en consola.
# DEBUG_EVENTOS=false

# PORTADA INSTITUCIONAL / PRESENTACIÓN DE PRODUCTO (DIS-118)
# Controla si se despliega la portada corporativa en /portada y /presentacion:
# - true: Activa la portada como landing page para visitantes no autenticados y
#         muestra el enlace de presentación en la pantalla de acceso (/login).
# - false: Desactiva la portada; visitantes no autenticados van directo al /login.
#          Ideal para despliegues productivos donde se requiere ingreso directo.
# Por defecto: true
PORTADA_ACTIVA=true

# Next.js (frontend/): URL base del backend para la comunicación de la interfaz.
BACKEND_URL=http://localhost:5001

# Solo estas direcciones pueden inyectar las cabeceras Remote-* del SSO y,
# para la auditoría, X-Forwarded-For (IP real del cliente, FNC-047).
TRUSTED_PROXIES=127.0.0.1,::1

# CARTA RESPONSIVA DE TI Y ACCESOS A PLATAFORMAS (FNC-155)
# Define si la responsiva se firma una sola vez o por cada plataforma otorgada:
# - global: Se firma UNA SOLA VEZ en la vida del usuario (al otorgársele el primer acceso).
#           Plataformas posteriores aprobadas/asignadas se activan de inmediato sin volver a firmar.
# - por_plataforma: Cada vez que se aprueba u otorga una plataforma, el usuario debe firmar la
#                   responsiva para esa herramienta antes de poder usarla y aprovisionarse.
# Vacío = global (firma única vitalicia).
RESPONSIVA_MODO=global
# Alternativa booleana (true = por plataforma, false = global):
# RESPONSIVA_POR_PLATAFORMA=false

# DIRECTORIO OpenLDAP (FNC-040, ADR-004)
# Vacío = directorio inactivo. Con LDAP_URL definida, la app no arranca si
# falta algo o si no hay TLS: ldaps://<host> o ldap://<host> (con StartTLS).
# Solo nombres de host, nunca IP. Los valores los define el dueño.
LDAP_URL=
# CA para validar el certificado del servidor; vacío = CA del sistema.
LDAP_CA_CERT_FILE=
LDAP_BIND_DN=
# Secreto: .env en dev. Fuera de dev, esta (inyectada en el .env, ADR-005 C)
# o LDAP_BIND_PASSWORD_REF, nunca las dos.
LDAP_BIND_PASSWORD=
# Solo staging/producción (FNC-068): nombre del ítem de Vaultwarden con la
# contraseña de bind (p. ej. pokemon/produccion/LDAP_BIND_PASSWORD).
LDAP_BIND_PASSWORD_REF=
LDAP_USERS_BASE_DN=
LDAP_GROUPS_BASE_DN=
# OU de grupos inactivos (FNC-163): al pasar un área o plataforma a Inactiva, el
# worker mueve sus grupos aquí y los regresa al reactivar. Debe existir, estar
# fuera de LDAP_GROUPS_BASE_DN y fuera de la búsqueda de grupos de Authelia.
# Vacío = función apagada (desactivar solo afecta al portal).
LDAP_GROUPS_INACTIVE_BASE_DN=
# Esquema (por defecto, el estándar de OpenLDAP): uid, groupOfNames, member.
LDAP_USER_ATTR=uid
LDAP_GROUP_OBJECT_CLASS=groupOfNames
LDAP_GROUP_MEMBER_ATTR=member
LDAP_TIMEOUT_SECONDS=5
# Escritura (FNC-041). Clases de las cuentas que crea el portal, separadas
# por coma; vacío = inetOrgPerson.
LDAP_USER_OBJECT_CLASSES=
# DN que ocupa un groupOfNames al quitar a su último miembro; vacío = no se
# quita el último miembro (la baja falla como error permanente).
LDAP_GROUP_PLACEHOLDER_MEMBER=
# Convención del DN de grupo de cada plataforma (FNC-046), relativa a
# LDAP_GROUPS_BASE_DN. Marcadores: {plataforma} y {nivel} obligatorios, {area}
# opcional. Ejemplo: cn=app-{plataforma}-{nivel}
LDAP_PLATFORM_GROUP_TEMPLATE=cn=app-{plataforma}-{nivel}
# Auto-creación de grupos en LDAP al dar de alta una plataforma o durante el aprovisionamiento
# (FNC-196: sin definir, el aprovisionamiento crea el grupo faltante; false lo apaga)
LDAP_AUTO_CREATE_PLATFORM_GROUPS=true
LDAP_PROVISIONING_AUTO_CREATE_GROUPS=true
# Niveles en plural inglés (users/admins) en LDAP_PLATFORM_GROUP_TEMPLATE;
# con el prefijo app- ya se aplica.
# LDAP_GROUP_PLURAL=false

# AUTOSERVICIO DE CONTRASEÑAS (IDENTIDAD AUTHELIA & MFA)
# Marca institucional visible en el portal de autoservicio (por defecto: Authelia)
AUTOSERVICIO_BRAND_NAME=Authelia
# URL directa del portal de Authelia SSO (ej. https://auth.vivaro.com o https://authelia.vivaro.com)
AUTHELIA_URL=
# Activar autenticación de doble factor en el portal de autoservicio (true | false)
AUTOSERVICIO_MFA_ENABLED=true
# Tipo de MFA: email (código de 6 dígitos por correo), authenticator (TOTP RFC 6238) o ambos
AUTOSERVICIO_MFA_TIPO=email
# Tiempo de expiración del código de 6 dígitos por correo en minutos (por defecto: 10 minutos)
AUTOSERVICIO_MFA_TTL_MINUTOS=10
# NOTA SOBRE SMTP: Si AUTOSERVICIO_MFA_TIPO=email, se requiere un servidor de correo saliente.
# El sistema reutiliza automáticamente el servidor global configurado en las variables SMTP_*
# (o el configurado en la interfaz en Ajustes > Servidor de Correo).
# Si deseas usar un servidor SMTP dedicado exclusivamente para el portal de Autoservicio/Authelia,
# completa las siguientes variables (vacías = no definidas; se usa el servidor global):
AUTOSERVICIO_SMTP_SERVER=
AUTOSERVICIO_SMTP_PORT=
AUTOSERVICIO_SMTP_USER=
AUTOSERVICIO_SMTP_PASSWORD=
AUTOSERVICIO_SMTP_ENCRYPTION=
AUTOSERVICIO_SMTP_SENDER_EMAIL=
AUTOSERVICIO_SMTP_SENDER_NAME=

# Vida del código MFA en segundos: solo se usa si AUTOSERVICIO_MFA_TTL_MINUTOS está vacía (vacía = 600).
AUTOSERVICIO_MFA_TTL_SEGUNDOS=
# JumpServer: aviso de cada cambio de contraseña del autoservicio (vacío = apagado).
# El token es secreto: solo en el .env real, nunca aquí con valor.
JUMPSERVER_API_URL=
JUMPSERVER_API_TOKEN=

# ALIAS heredados (vacíos): solo se leen si falta la variable principal. Usa la principal.
# ALIAS heredado de AUTOSERVICIO_MFA_TTL_MINUTOS
AUTOSERVICIO_MFA_EXPIRACION_MINUTOS=
# ALIAS heredado de AUTOSERVICIO_MFA_TTL_SEGUNDOS
AUTOSERVICIO_MFA_EXPIRACION_SEGUNDOS=
# ALIAS heredado de PASSWORD_POLICY_GENERATED_LENGTH
AUTOSERVICIO_PASSWORD_LENGTH=
# ALIAS heredado de AUTHELIA_URL
AUTHELIA_SSO_URL=
# ALIAS heredado de JUMPSERVER_API_URL
JUMPSERVER_URL=

# Motivo al solicitar y al rechazar (FNC-216, decisión del dueño 2026-11-27).
# SOLICITUD_MOTIVO: oculto (por omisión; se descarta) | opcional | obligatorio.
# RECHAZO_MOTIVO: obligatorio (por omisión, 10-500 caracteres) | opcional | oculto.
# Un valor distinto detiene el arranque.
SOLICITUD_MOTIVO=oculto
RECHAZO_MOTIVO=obligatorio
